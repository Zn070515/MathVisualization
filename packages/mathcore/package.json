{
  "name": "@mathviz/mathcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical mathematical model: AST, parser, type system, evaluator, CAS adapter contract and GLSL lowering. No runtime dependencies by design.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^2.1.8"
  }
}
